# Скопируйте в .env и при необходимости поправьте значения.
# .env в .gitignore — реальные пароли в репозиторий не попадают.

# --- Подключение к MariaDB/MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=retail_dwh
DB_USER=retail_app
DB_PASSWORD=retail_app_pwd

# Права root для первичного создания БД и пользователя
# (используется только database/01_create_database.sql, запускается вручную).

# --- Параметры конвейера ---
# Сколько строк читать из источника (0 или пусто = все ~1.07 млн)
ETL_SAMPLE_ROWS=0
# Пересоздавать parquet-снимки, даже если уже существуют
ETL_FORCE_REBUILD=0
# Грузить ли слой staging (сырые строки как есть). 0 ускоряет прогон,
# на витрины и аналитику не влияет.
ETL_LOAD_STAGING=1
